{
  "$defs": {
    "AlsoCoveredBy": {
      "additionalProperties": false,
      "properties": {
        "source_id": {
          "maxLength": 64,
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "title": "Source Id",
          "type": "string"
        },
        "url": {
          "maxLength": 2048,
          "minLength": 8,
          "title": "Url",
          "type": "string"
        }
      },
      "required": [
        "source_id",
        "url"
      ],
      "title": "AlsoCoveredBy",
      "type": "object"
    },
    "Signals": {
      "additionalProperties": false,
      "properties": {
        "comments": {
          "default": 0,
          "minimum": 0,
          "title": "Comments",
          "type": "integer"
        },
        "points": {
          "default": 0,
          "minimum": 0,
          "title": "Points",
          "type": "integer"
        },
        "stars": {
          "default": 0,
          "minimum": 0,
          "title": "Stars",
          "type": "integer"
        }
      },
      "title": "Signals",
      "type": "object"
    }
  },
  "$id": "https://raw.githubusercontent.com/gowthamsai09/Axon/main/schemas/feed-item.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "also_covered_by": {
      "items": {
        "$ref": "#/$defs/AlsoCoveredBy"
      },
      "maxItems": 50,
      "title": "Also Covered By",
      "type": "array"
    },
    "author": {
      "anyOf": [
        {
          "maxLength": 200,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Author"
    },
    "base_score": {
      "maximum": 1,
      "minimum": 0,
      "title": "Base Score",
      "type": "number"
    },
    "canonical_url": {
      "maxLength": 2048,
      "minLength": 8,
      "title": "Canonical Url",
      "type": "string"
    },
    "cluster_id": {
      "anyOf": [
        {
          "maxLength": 64,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Cluster Id"
    },
    "entities": {
      "items": {
        "maxLength": 100,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 20,
      "title": "Entities",
      "type": "array"
    },
    "excerpt": {
      "anyOf": [
        {
          "maxLength": 2200,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Excerpt"
    },
    "fetched_at": {
      "format": "date-time",
      "title": "Fetched At",
      "type": "string"
    },
    "id": {
      "pattern": "^[a-f0-9]{16}$",
      "title": "Id",
      "type": "string"
    },
    "published_at": {
      "format": "date-time",
      "title": "Published At",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "signals": {
      "$ref": "#/$defs/Signals"
    },
    "snippet": {
      "maxLength": 300,
      "title": "Snippet",
      "type": "string"
    },
    "source_id": {
      "maxLength": 64,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "title": "Source Id",
      "type": "string"
    },
    "source_type": {
      "enum": [
        "rss",
        "api",
        "github_releases"
      ],
      "title": "Source Type",
      "type": "string"
    },
    "tags": {
      "items": {
        "enum": [
          "llm-releases",
          "open-source-llms",
          "small-local-models",
          "multimodal",
          "agents-tooling",
          "rag",
          "fine-tuning-training",
          "research-papers",
          "mlops-infra",
          "ai-hardware",
          "evals-benchmarks",
          "safety-alignment",
          "ai-policy-regulation",
          "ai-products-apps",
          "datasets",
          "robotics"
        ],
        "type": "string"
      },
      "maxItems": 16,
      "title": "Tags",
      "type": "array"
    },
    "title": {
      "maxLength": 500,
      "minLength": 1,
      "title": "Title",
      "type": "string"
    },
    "url": {
      "maxLength": 2048,
      "minLength": 8,
      "title": "Url",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "id",
    "url",
    "canonical_url",
    "title",
    "source_id",
    "source_type",
    "published_at",
    "fetched_at",
    "snippet",
    "base_score"
  ],
  "title": "FeedItem",
  "type": "object"
}
